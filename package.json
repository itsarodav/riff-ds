{
  "name": "riff-ds",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "tokens": "npm run build -w @riff-ds/tokens && node apps/playground/scripts/build-theme.mjs",
    "prestart": "npm run tokens",
    "start": "ng serve playground",
    "prebuild": "npm run tokens",
    "build": "ng build playground",
    "watch": "ng build playground --watch --configuration development",
    "test": "ng test playground"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
