{
  "font": {
    "$description": "Primitivos de tipografía (valores de riffims). Tamaños en px; el build genera rem (por defecto) y px (sufijo -px).",
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Albert Sans",
          "sans-serif"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "2xs": {
        "$value": {
          "value": 10,
          "unit": "px"
        }
      },
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "base": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "3xl": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "4xl": {
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "5xl": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "6xl": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "7xl": {
        "$value": {
          "value": 52,
          "unit": "px"
        }
      },
      "8xl": {
        "$value": {
          "value": 56,
          "unit": "px"
        }
      },
      "9xl": {
        "$value": {
          "value": 60,
          "unit": "px"
        }
      },
      "10xl": {
        "$value": {
          "value": 64,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "thin": {
        "$value": 100
      },
      "extralight": {
        "$value": 200
      },
      "light": {
        "$value": 300
      },
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "extrabold": {
        "$value": 800
      },
      "black": {
        "$value": 900
      }
    }
  },
  "line-height": {
    "$type": "number",
    "tight": {
      "$value": 1.1
    },
    "snug": {
      "$value": 1.25
    },
    "normal": {
      "$value": 1.5
    },
    "relaxed": {
      "$value": 1.75
    }
  }
}
